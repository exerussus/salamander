{
  "name": "salamander",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.4",
  "publisher": "local",
  "icon": "icons/salamander-128.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:salamander",
    "workspaceContains:**/salamander-api.json"
  ],
  "contributes": {
    "languages": [
      {
        "id": "salamander",
        "aliases": [
          "Salamander",
          "salamander"
        ],
        "extensions": [
          ".sal"
        ],
        "filenamePatterns": [
          "*.sal"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/salamander.svg",
          "dark": "./icons/salamander.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "salamander",
        "scopeName": "source.salamander",
        "path": "./syntaxes/salamander.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "salamander",
        "path": "./snippets/salamander.json"
      }
    ],
    "commands": [
      {
        "command": "salamander.check",
        "title": "%command.check%"
      }
    ],
    "configuration": {
      "title": "Salamander",
      "properties": {
        "salamander.server.path": {
          "type": "string",
          "default": "",
          "description": "%config.server.path%"
        },
        "salamander.apiManifest": {
          "type": "string",
          "default": "",
          "description": "%config.apiManifest%"
        },
        "salamander.modulesRoot": {
          "type": "string",
          "default": "",
          "description": "%config.modulesRoot%"
        },
        "salamander.referencePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.referencePaths%"
        },
        "salamander.buildFile": {
          "type": "string",
          "default": "",
          "description": "%config.buildFile%"
        },
        "salamander.language": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "ru",
            "en"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.ru%",
            "%config.language.en%"
          ],
          "description": "%config.language%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
